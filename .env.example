# Copy to .env and fill in. `python discover.py` fills SODEXO_API_KEY for you.
SODEXO_API_KEY=
# Signs login cookies. Leave blank and the app generates one and saves it here on first run.
# Keep it secret; changing it logs everyone out.
SECRET_KEY=
# Where accounts and calorie logs are stored (default: data/maxalert.db)
# DATABASE_URL=sqlite:////full/path/to/maxalert.db
# Set to 1 only when the site is served over HTTPS
SECURE_COOKIES=
# For the "Anything good?" button (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Optional: get a push/Discord/Slack message if menus stop updating (see README)
ALERT_WEBHOOK_URL=
# ALERT_AFTER_HOURS=12
# How often to re-download menus
REFRESH_HOURS=3
# Set to 1 to force made-up sample data
DEMO_MODE=
